{
  "id": "root",
  "cloned_from": {
    "name": "main",
    "version": "0.1.14"
  },
  "type": "row",
  "children": [
    {
      "id": "sidebar",
      "type": "column",
      "children": [
        {
          "id": "brand",
          "type": "block",
          "content": {
            "mod": "wrath-chrome"
          },
          "size": {
            "px": 46
          },
          "window_drag": true
        },
        {
          "id": "sidebar-lists",
          "type": "column",
          "children": [
            {
              "id": "spaces",
              "type": "block",
              "content": {
                "mod": "wrath-spaces"
              },
              "size": {
                "weight": 1
              },
              "min": 90
            },
            {
              "id": "agents",
              "type": "block",
              "content": {
                "mod": "wrath-agents"
              },
              "size": {
                "weight": 1
              },
              "min": 90
            }
          ]
        },
        {
          "id": "sidebar-footer",
          "type": "block",
          "content": {
            "mod": "wrath-chrome",
            "props": {
              "footer": true
            }
          },
          "size": {
            "px": 69
          }
        }
      ],
      "size": {
        "px": 268
      },
      "min": 44,
      "max": 480,
      "background": {
        "image": "backgrounds/sidebar-sol-rubro.png",
        "fit": "cover"
      },
      "resizable": false
    },
    {
      "id": "chain",
      "type": "block",
      "content": {
        "mod": "wrath-chain"
      },
      "size": {
        "px": 20
      },
      "min": 20,
      "max": 20,
      "background": {
        "image": "backgrounds/chain.png",
        "fit": "cover"
      },
      "resizable": false
    },
    {
      "id": "work",
      "type": "column",
      "children": [
        {
          "id": "tabs",
          "type": "block",
          "content": {
            "mod": "wrath-tabs"
          },
          "size": {
            "px": 42
          },
          "window_drag": true
        },
        {
          "id": "work-body",
          "type": "row",
          "children": [
            {
              "id": "main",
              "type": "block",
              "content": {
                "tab": "active",
                "pane": {
                  "header": {
                    "content": {
                      "mod": "wrath-pane"
                    },
                    "reveal": "always",
                    "height": 34,
                    "position": "top"
                  },
                  "background": "#0c070922",
                  "border": {
                    "width": 1,
                    "color": "#7a5530"
                  },
                  "focus": {
                    "width": 2,
                    "color": "#d4a24c"
                  },
                  "radius": 2,
                  "gap": 10,
                  "lone": true
                }
              },
              "shadow": "lg"
            },
            {
              "id": "panel",
              "type": "column",
              "children": [
                {
                  "id": "panel-body",
                  "type": "stack",
                  "children": [
                    {
                      "id": "files",
                      "type": "block",
                      "content": {
                        "mod": "wrath-files"
                      }
                    },
                    {
                      "id": "changes",
                      "type": "block",
                      "content": {
                        "mod": "wrath-changes"
                      }
                    },
                    {
                      "id": "ritual",
                      "type": "block",
                      "content": {
                        "mod": "wrath-ritual"
                      }
                    },
                    {
                      "id": "chronicle",
                      "type": "block",
                      "content": {
                        "mod": "wrath-chronicle"
                      }
                    },
                    {
                      "id": "heralds",
                      "type": "block",
                      "content": {
                        "mod": "wrath-heralds"
                      }
                    },
                    {
                      "id": "jira",
                      "type": "block",
                      "content": {
                        "mod": "wrath-jira"
                      }
                    }
                  ],
                  "active": "files"
                }
              ],
              "size": {
                "px": 368
              },
              "min": 280,
              "max": 900,
              "hidden": true
            }
          ],
          "padding": 8,
          "gap": 8
        },
        {
          "id": "status",
          "type": "block",
          "content": {
            "mod": "wrath-status"
          },
          "size": {
            "px": 28
          },
          "border": {
            "width": 1,
            "color": "#5a3a1e"
          }
        }
      ],
      "resizable": false
    }
  ],
  "background": {
    "image": "backgrounds/worldwound.png",
    "fit": "cover"
  },
  "theme": "tomo-rubro",
  "colors": {
    "canvas": "#0b060800",
    "chrome": "#120a0db8"
  },
  "font": "JetBrains Mono",
  "font_size": 14,
  "ui_font": "EB Garamond",
  "terminal_padding": [
    14,
    12
  ],
  "terminal_opacity": 0.30000001192092896,
  "divider": {
    "width": 1,
    "color": "#5a3a1e"
  },
  "titlebar": "none",
  "traffic_lights": [
    12,
    16
  ],
  "preview": "layouts/tomo-rubro.svg",
  "terminal_menu": "wrath-menu"
}
